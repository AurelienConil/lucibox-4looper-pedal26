[Unit]
Description=Lucibox PureData
After=jack.service
Wants=jack.service

[Service]
User=patch
Environment=JACK_PROMISCUOUS_SERVER=jack
WorkingDirectory=/home/patch/lucibox/puredata
ExecStart=/home/patch/lucibox/script/autostart.sh
Restart=on-failure
RestartSec=5
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=70
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE
SecureBits=keep-caps

[Install]
WantedBy=multi-user.target
